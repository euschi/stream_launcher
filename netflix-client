#!/usr/bin/env bash
# Avvia il client Netflix sul runtime Firefox portatile con profilo dedicato.
set -euo pipefail

APP_ID="NetflixClient"
DATA_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/netflix-client"
FIREFOX="$DATA_DIR/firefox/firefox"
PROFILE="$DATA_DIR/profile"

if [[ ! -x "$FIREFOX" ]]; then
  echo "Runtime non trovato in $FIREFOX: esegui prima install.sh" >&2
  exit 1
fi

# Wayland nativo se disponibile, altrimenti X11.
if [[ "${XDG_SESSION_TYPE:-}" == "wayland" ]]; then
  export MOZ_ENABLE_WAYLAND=1
fi

exec "$FIREFOX" \
  --name "$APP_ID" \
  --class "$APP_ID" \
  --profile "$PROFILE" \
  --no-remote \
  "$@" \
  "https://www.netflix.com/browse"
